  "language_probability": 1,
  "segments": [
    {
      "start": 0.0,
      "end": 3.52,
      "text": " A fire ant colony doesn't always have a mound you can see.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 4.12,
      "end": 8.46,
      "text": " In a drought, the ground itself can be too hard and dry for them to build one.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 8.98,
      "end": 12.3,
      "text": " A colony has more going on than workers walking around outside.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 12.92,
      "end": 15.72,
      "text": " It also has a developing generation underground.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 16.64,
      "end": 18.06,
      "text": " Eggs, larvae, and pupae.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 18.64,
      "end": 20.98,
      "text": " Together, those stages are called brood.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 21.8,
      "end": 26.52,
      "text": " Eggs hatch into larvae, larvae become pupae, and adults eventually emerge.",
      "avg_logprob": -0.0980025938898325
    },
    {
      "start": 27.24,
      "end": 30.5,
      "text": " Those young ants are part of the reason nest conditions matter.",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 31.34,
      "end": 35.54,
      "text": " During cold, wet weather, colonies tend to occupy higher parts of the nest,",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 35.76,
      "end": 39.88,
      "text": " where they can take advantage of sunlight and keep brood away from waterlogged soil.",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 40.64,
      "end": 45.82,
      "text": " During hot, dry weather, cooler, moisture conditions below ground become useful instead.",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 46.56,
      "end": 49.6,
      "text": " Workers move the brood within the nest as conditions change.",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 50.3,
      "end": 53.32,
      "text": " Picture the nursery shifting between different parts of the structure,",
      "avg_logprob": -0.10154620642514572
    },
    {
      "start": 53.32,
      "end": 56.92,
      "text": " rather than every ant staying in one fixed room all season.",
      "avg_logprob": -0.07982436897828407
    },
    {
      "start": 57.66,
      "end": 62.18,
      "text": " So the nest you see above ground doesn't show you where the developing ants are being kept.",
      "avg_logprob": -0.07982436897828407
    },
    {
      "start": 62.6,
      "end": 67.4,
      "text": " The colony's internal activity can continue out of sight while the surface looks quiet.",
      "avg_logprob": -0.07982436897828407
    },
    {
      "start": 68.02,
      "end": 71.08,
      "text": " For a homeowner, that changes what a missing mound means.",
      "avg_logprob": -0.07982436897828407
    },
    {
      "start": 71.58,
      "end": 73.9,
      "text": " You're losing a visible clue about the nest,",
      "avg_logprob": -0.07982436897828407
    },
    {
      "start": 74.16,
      "end": 78.22,
      "text": " not getting a direct measurement of the colony's condition or its developing young.",
      "avg_logprob": -0.07982436897828407
    }
  ],
