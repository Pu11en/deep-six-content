   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A  Claude chooses the next search strategy",
   "originalText": "A  Claude chooses the next search strategy",
   "fontSize": 22,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
