   "version": 1,
   "versionNonce": 21528502,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Built: five or one scripts, separate edit, exact hook and outro checks,\npick or reject, locked approval with fingerprint, feedback memory.\nWriter today: Astra, then Sol (Claude was out of credits).\nDesign: Opus 5.5 first. Backup when Claude runs out: Sol or Astra.\nStill needed: change-one-line edits with re-approval, version\nhistory for approved scripts, one resume screen, a live Opus trial.",
   "originalText": "Built: five or one scripts, separate edit, exact hook and outro checks,\npick or reject, locked approval with fingerprint, feedback memory.\nWriter today: Astra, then Sol (Claude was out of credits).\nDesign: Opus 5.5 first. Backup when Claude runs out: Sol or Astra.\nStill needed: change-one-line edits with re-approval, version\nhistory for approved scripts, one resume screen, a live Opus trial.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
