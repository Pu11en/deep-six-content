  },
  {
   "id": "rd_adapt_body",
   "type": "text",
   "x": 4644,
   "y": 2753.5,
   "width": 595.2,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "rd_adapt_g"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 231368286,
   "version": 1,
   "versionNonce": 221528534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Drew can reject with no explanation. Claude changes approach.\nUse search history, source quality and variety to choose how.\nTry new questions, mechanisms, species, authors or publishers.\nUse past likes as clues, without inventing a rejection reason.\nJudge the next results; do not repeat the same failed batch.",
   "originalText": "Drew can reject with no explanation. Claude changes approach.\nUse search history, source quality and variety to choose how.\nTry new questions, mechanisms, species, authors or publishers.\nUse past likes as clues, without inventing a rejection reason.\nJudge the next results; do not repeat the same failed batch.",
   "fontSize": 16,
   "fontFamily": 3,
