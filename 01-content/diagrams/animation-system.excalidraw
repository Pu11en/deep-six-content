   "version": 1,
   "versionNonce": 5112305,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Claude gives Ultimate Crawler search words.\nCrawler uses Parallel web search for links.\nClaude picks links; crawler reads those pages.\nClaude checks them and prepares five choices.",
   "originalText": "Claude gives Ultimate Crawler search words.\nCrawler uses Parallel web search for links.\nClaude picks links; crawler reads those pages.\nClaude checks them and prepares five choices.",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "inside": "p1"
   }
  },
  {
   "id": "p1_note_h0",
   "type": "text",
   "x": 3738,
   "y": 659.0,
   "width": 99.0,
   "height": 18.75,
