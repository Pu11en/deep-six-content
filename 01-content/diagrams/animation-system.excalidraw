   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Timeout or error: check account history first. Credits may be used.\nFile arrived but broken: recover the saved bytes before a new take.\nNot enough credits: stop and tell Drew. No top-up.\nDouble click or two sessions: the lock blocks a second paid request.",
   "originalText": "Timeout or error: check account history first. Credits may be used.\nFile arrived but broken: recover the saved bytes before a new take.\nNot enough credits: stop and tell Drew. No top-up.\nDouble click or two sessions: the lock blocks a second paid request.",
   "fontSize": 16,
   "fontFamily": 3,
