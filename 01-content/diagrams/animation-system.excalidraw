   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 The facts don't back up your hook: it stops and asks you.\n  It never quietly rewrites your hook.\n\u2022 A source can't be read anymore: that fact waits until\n  it's backed up again.\n\u2022 A wording-only redo reuses the facts already checked.",
   "originalText": "\u2022 The facts don't back up your hook: it stops and asks you.\n  It never quietly rewrites your hook.\n\u2022 A source can't be read anymore: that fact waits until\n  it's backed up again.\n\u2022 A wording-only redo reuses the facts already checked.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
