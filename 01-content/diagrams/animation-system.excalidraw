   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 Approve.\n\u2022 A wrong word: fix just that word, then a short test.\n\u2022 Flat delivery: a short sample with the same voice.\n\u2022 Don't like the voice: short samples of other voices.\n\u2022 Content problem: back to the script, step 5.",
   "originalText": "\u2022 Approve.\n\u2022 A wrong word: fix just that word, then a short test.\n\u2022 Flat delivery: a short sample with the same voice.\n\u2022 Don't like the voice: short samples of other voices.\n\u2022 Content problem: back to the script, step 5.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
