   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Built: saved sources by pest, duplicate checks, rejection feedback,\nand a separate crawler request after hook selection.\nStill needed: episode rotation and the research rules below.\nProposed: wider discovery and persistent partial batches.\nCurrent importer stops unless exactly five pass.",
   "originalText": "Built: saved sources by pest, duplicate checks, rejection feedback,\nand a separate crawler request after hook selection.\nStill needed: episode rotation and the research rules below.\nProposed: wider discovery and persistent partial batches.\nCurrent importer stops unless exactly five pass.",
