  {
   "id": "side_jobs_body",
   "type": "text",
   "x": 3744,
   "y": 206,
   "width": 490.2,
   "height": 285.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 226092335,
   "version": 1,
   "versionNonce": 86912261,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  Pick the sources you like.\n2  Pick one of five hooks.\n3  Pick one of five scripts.\n4  OK the cost of the voice recording.\n5  Listen and approve the recording.\n6  Pick when the video starts.\n7  New bug only: approve its drawing.\n8  Risky runs only: watch the first piece.\n9  Watch the video: approve or give notes.\n\nAt any choice you can pick, say no and why,\nor stop. Silence never counts as a yes.",
   "originalText": "1  Pick the sources you like.\n2  Pick one of five hooks.\n3  Pick one of five scripts.\n4  OK the cost of the voice recording.\n5  Listen and approve the recording.\n6  Pick when the video starts.\n7  New bug only: approve its drawing.\n8  Risky runs only: watch the first piece.\n9  Watch the video: approve or give notes.\n\nAt any choice you can pick, say no and why,\nor stop. Silence never counts as a yes.",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
