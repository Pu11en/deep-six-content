   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "p1_note_b0",
   "type": "text",
   "x": 3738,
   "y": 683.75,
   "width": 576.0,
   "height": 140.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
