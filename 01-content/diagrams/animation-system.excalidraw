   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A search outage is different from finding no good sources.\nUnreadable page: try its original accessible version.\nKeep good results; widen the next bounded search when useful.\nNo progress: report the gap; offer fewer choices or pause.\nKeep quality and no-reuse rules. Fresh sources are not endless.",
   "originalText": "A search outage is different from finding no good sources.\nUnreadable page: try its original accessible version.\nKeep good results; widen the next bounded search when useful.\nNo progress: report the gap; offer fewer choices or pause.\nKeep quality and no-reuse rules. Fresh sources are not endless.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
