  {
   "id": "side_wrong_body",
   "type": "text",
   "x": 2984,
   "y": 5374.5,
   "width": 501.6,
   "height": 237.5,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
