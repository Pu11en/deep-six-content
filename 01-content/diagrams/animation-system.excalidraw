  {
   "id": "rd_broader_body",
   "type": "text",
   "x": 5644,
   "y": 1953.5,
   "width": 643.2,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "rd_broader_g"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 16415437,
   "version": 1,
   "versionNonce": 147131830,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Search beyond a fixed list; admit sources by checked evidence.\nUF/IFAS, UC IPM, Mississippi State, Oklahoma State, USDA ARS.\nFollow useful studies, their authors and their original references.\nExpert articles/videos: verify author, content and factual support.\nSocial questions can suggest topics; they do not prove facts.",
   "originalText": "Search beyond a fixed list; admit sources by checked evidence.\nUF/IFAS, UC IPM, Mississippi State, Oklahoma State, USDA ARS.\nFollow useful studies, their authors and their original references.\nExpert articles/videos: verify author, content and factual support.\nSocial questions can suggest topics; they do not prove facts.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "inside": "rd_broader"
   }
  },
