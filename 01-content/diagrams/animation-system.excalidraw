  {
   "id": "retry_text",
   "type": "text",
   "x": 2150,
   "y": 4295.74,
   "width": 499.2,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
