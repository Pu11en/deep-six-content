   "updated": 1,
   "link": null,
   "locked": false,
   "text": "APPROVED EXAMPLE: ENSIGN WASP, 138 WORDS, 20 OCT",
   "originalText": "APPROVED EXAMPLE: ENSIGN WASP, 138 WORDS, 20 OCT",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
