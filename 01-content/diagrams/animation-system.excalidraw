   "version": 1,
   "versionNonce": 212702889,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A paid recording never repeats by itself.\nA check fails: the AI fixes it and tries\nagain, up to two more times.\nStill failing: the video stops and waits for\nyou. Nothing is lost.\nClaude runs out: save progress and wait.\nResume with Claude when available.\nIt picks up where it left off; finished\npieces are kept.\nNothing ever pops up on your screen.",
   "originalText": "A paid recording never repeats by itself.\nA check fails: the AI fixes it and tries\nagain, up to two more times.\nStill failing: the video stops and waits for\nyou. Nothing is lost.\nClaude runs out: save progress and wait.\nResume with Claude when available.\nIt picks up where it left off; finished\npieces are kept.\nNothing ever pops up on your screen.",
   "fontSize": 19,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
