  {
   "id": "rd_history_body",
   "type": "text",
   "x": 5644,
   "y": 1603.5,
   "width": 614.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "rd_history_g"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 259792206,
   "version": 1,
   "versionNonce": 60910712,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Shown / rejected / liked and queued / reserved / used.\nCompare links, publisher + title and matching page text.\nUnchosen is not disliked or permanently used.\nSame-episode edits can keep their evidence.\nA finished episode consumes main and supporting publications.\nKeep lesson history too: a new article can repeat an old lesson.",
   "originalText": "Shown / rejected / liked and queued / reserved / used.\nCompare links, publisher + title and matching page text.\nUnchosen is not disliked or permanently used.\nSame-episode edits can keep their evidence.\nA finished episode consumes main and supporting publications.\nKeep lesson history too: a new article can repeat an old lesson.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "inside": "rd_history"
   }
  },
