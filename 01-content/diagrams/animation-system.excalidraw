   "seed": 226345949,
   "version": 1,
   "versionNonce": 158998726,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Plan fails its check: the Director retries twice\nwith the errors.\n\nSegment fails a check or review: the Animator\nretries twice with notes; the best try is kept.\n\nRender or encoder crash: retry once.\n\nStill failing: park. Stop this video, keep all work,\nand write the reason in the status note.\n\nTime limits: AI job 3 h, render 4 h.\nA timeout counts as a failure.\n\nNothing pops up on Drew's screen.",
   "originalText": "Plan fails its check: the Director retries twice\nwith the errors.\n\nSegment fails a check or review: the Animator\nretries twice with notes; the best try is kept.\n\nRender or encoder crash: retry once.\n\nStill failing: park. Stop this video, keep all work,\nand write the reason in the status note.\n\nTime limits: AI job 3 h, render 4 h.\nA timeout counts as a failure.\n\nNothing pops up on Drew's screen.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
