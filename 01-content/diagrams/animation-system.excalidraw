  {
   "id": "ref_problems_body",
   "type": "text",
   "x": 64,
   "y": 7931.49,
   "width": 462.0,
   "height": 525.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 88657952,
   "version": 1,
   "versionNonce": 176989982,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Hero ant close-up cluttered by other ants\n  Keep neighbours out of the close-up window.\nMound too small; magnifier hidden by captions\n  Enlarge; key action above y 1250; props last.\nPath2D.addPath drew tunnels as one big triangle\n  Round-capped strokes; build paths by hand.\nCharacters overlapping after a pull-back\n  Space them, or walk them in during the move.\nAnts upside down on slopes\n  Rotation = path angle; facing from direction.\nEmpty sky in side views\n  Zoom until the subject fills the frame width.\nMotion blur made paper slides look ghostly\n  Blur only big zooms and whips.\nBrood and life cycle too small to read\n  Close-ups: items fill a third of the frame.\nA full lime loop vanished\n  An arc of exactly 2*PI draws nothing; stop short.\nMagnifier never appeared\n  Check each beat's named element is visible.\nGauge overlapping the homeowner\n  Check props against characters at the beat.\nTunnel ant above a quiet, mound-less lawn\n  Hide everything above ground when the mound is off.\nHolds went still for up to 1 s\n  Keep the camera breathing (live); push through holds.\nDrifting clouds off-screen during their shot\n  Check drifting props at the shot's actual time.\nHeat tint leaked into the sky\n  Clip effects to the region they describe.",
   "originalText": "Hero ant close-up cluttered by other ants\n  Keep neighbours out of the close-up window.\nMound too small; magnifier hidden by captions\n  Enlarge; key action above y 1250; props last.\nPath2D.addPath drew tunnels as one big triangle\n  Round-capped strokes; build paths by hand.\nCharacters overlapping after a pull-back\n  Space them, or walk them in during the move.\nAnts upside down on slopes\n  Rotation = path angle; facing from direction.\nEmpty sky in side views\n  Zoom until the subject fills the frame width.\nMotion blur made paper slides look ghostly\n  Blur only big zooms and whips.\nBrood and life cycle too small to read\n  Close-ups: items fill a third of the frame.\nA full lime loop vanished\n  An arc of exactly 2*PI draws nothing; stop short.\nMagnifier never appeared\n  Check each beat's named element is visible.\nGauge overlapping the homeowner\n  Check props against characters at the beat.\nTunnel ant above a quiet, mound-less lawn\n  Hide everything above ground when the mound is off.\nHolds went still for up to 1 s\n  Keep the camera breathing (live); push through holds.\nDrifting clouds off-screen during their shot\n  Check drifting props at the shot's actual time.\nHeat tint leaked into the sky\n  Clip effects to the region they describe.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
