   }
  },
  {
   "id": "nr_example_body",
   "type": "text",
   "x": 5636,
   "y": 4029.5,
   "width": 663.6,
   "height": 122.5,
   "angle": 0,
   "strokeColor": "#22c55e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "nr_example_g"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 251618808,
   "version": 1,
   "versionNonce": 196107874,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "HOOK, exact: Why would a wasp lay its egg inside a cockroach's egg case?\nANSWER: A small wasp called an ensign wasp puts one egg inside...\nSTORY: tiny jaws cut the roach eggs; it grows into an adult; cuts a hole out.\nHOMEOWNER STEP: check warm, damp cracks for egg cases as well as live roaches.\nOUTRO, exact: Helping you understand pests. Deep Six Pest Control.\n\nSource credit and supporting links live in the file, never in the spoken words.",
   "originalText": "HOOK, exact: Why would a wasp lay its egg inside a cockroach's egg case?\nANSWER: A small wasp called an ensign wasp puts one egg inside...\nSTORY: tiny jaws cut the roach eggs; it grows into an adult; cuts a hole out.\nHOMEOWNER STEP: check warm, damp cracks for egg cases as well as live roaches.\nOUTRO, exact: Helping you understand pests. Deep Six Pest Control.\n\nSource credit and supporting links live in the file, never in the spoken words.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "inside": "nr_example"
   }
  },
