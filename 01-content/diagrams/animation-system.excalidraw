   "roundness": null,
   "seed": 167542098,
   "version": 1,
   "versionNonce": 120473623,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 Fewer than five good sources turn up: it says so.\n  It never makes one up.\n\u2022 The research tool is down: your saved sources stay safe,\n  and it reports what's missing.\n\u2022 The same article shows up under another name: it's caught.\n\u2022 Every pest already has three saved sources: research\n  pauses until some get used.",
   "originalText": "\u2022 Fewer than five good sources turn up: it says so.\n  It never makes one up.\n\u2022 The research tool is down: your saved sources stay safe,\n  and it reports what's missing.\n\u2022 The same article shows up under another name: it's caught.\n\u2022 Every pest already has three saved sources: research\n  pauses until some get used.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
