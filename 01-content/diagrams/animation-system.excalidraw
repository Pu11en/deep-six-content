   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022 A piece fails three times: the video stops and waits for\n  you, with the evidence.\n\u2022 The numbers pass but it looks bad: the reviewer can still\n  send it back.\n\u2022 The reviewer can only say no. Only you say yes.",
   "originalText": "\u2022 A piece fails three times: the video stops and waits for\n  you, with the evidence.\n\u2022 The numbers pass but it looks bad: the reviewer can still\n  send it back.\n\u2022 The reviewer can only say no. Only you say yes.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
