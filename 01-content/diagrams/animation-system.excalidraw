  {
   "id": "bar_rules",
   "type": "text",
   "x": 1300,
   "y": 512,
   "width": 643.2,
   "height": 320.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 137096678,
   "version": 1,
   "versionNonce": 45830125,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1  One picture per 1 to 3 spoken words, landing on the word.\n2  New shot every 0.7-1.5 s in the hook, never over 2 s anywhere.\n   Something new appears about every 0.5 s.\n3  Constant motion: the camera pushes or drifts through every hold.\n4  Literal first: show the exact thing named. Symbols only for\n   absence or negation: dashed outline, purple X, question mark.\n5  Cut-paper style C: paper pieces, soft shadows, fibre grain,\n   natural insect and soil colours plus the Deep Six colours.\n6  Word-synced captions: torn paper strips near y 1420, lime tape\n   on the spoken word, 1 to 4 words per group.\n7  Three or four reusable sets per video. Move the camera inside\n   a set; cut hard on a new sentence or idea.\n8  Science limits: correct anatomy; no invented mechanisms,\n   depths, temperatures or treatment advice.\n9  9:16, 1080x1920, 30 fps. Key action between y 250 and 1250;\n   bottom 300 px and right 120 px kept clear.",
   "originalText": "1  One picture per 1 to 3 spoken words, landing on the word.\n2  New shot every 0.7-1.5 s in the hook, never over 2 s anywhere.\n   Something new appears about every 0.5 s.\n3  Constant motion: the camera pushes or drifts through every hold.\n4  Literal first: show the exact thing named. Symbols only for\n   absence or negation: dashed outline, purple X, question mark.\n5  Cut-paper style C: paper pieces, soft shadows, fibre grain,\n   natural insect and soil colours plus the Deep Six colours.\n6  Word-synced captions: torn paper strips near y 1420, lime tape\n   on the spoken word, 1 to 4 words per group.\n7  Three or four reusable sets per video. Move the camera inside\n   a set; cut hard on a new sentence or idea.\n8  Science limits: correct anatomy; no invented mechanisms,\n   depths, temperatures or treatment advice.\n9  9:16, 1080x1920, 30 fps. Key action between y 250 and 1250;\n   bottom 300 px and right 120 px kept clear.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
