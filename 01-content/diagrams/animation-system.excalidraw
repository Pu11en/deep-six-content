  },
  {
   "id": "nr_lessons_body",
   "type": "text",
   "x": 5644,
   "y": 4279.5,
   "width": 758.4,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [
    "nr_lessons_g"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 79229929,
   "version": 1,
   "versionNonce": 242363616,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "First five: repetitive, obvious endings, filler. Fix: more science, one lesson.\nAbrupt sign-off: finish the teaching thought, then the outro.\nNo university names spoken. Plain words: sticky traps, cardboard boxes.\nExplain each step: the young wasp becomes an adult, then cuts its way out.\nLiked story, weak ending: keep the story, try five endings. Drew chose 3.\nAll of this now lives in the narration brief for every episode.",
   "originalText": "First five: repetitive, obvious endings, filler. Fix: more science, one lesson.\nAbrupt sign-off: finish the teaching thought, then the outro.\nNo university names spoken. Plain words: sticky traps, cardboard boxes.\nExplain each step: the young wasp becomes an adult, then cuts its way out.\nLiked story, weak ending: keep the story, try five endings. Drew chose 3.\nAll of this now lives in the narration brief for every episode.",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "customData": {
    "inside": "nr_lessons"
   }
  },
