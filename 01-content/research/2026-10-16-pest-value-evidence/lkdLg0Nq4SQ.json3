{
  "wireMagic": "pb3",
  "pens": [ {

  } ],
  "wsWinStyles": [ {

  } ],
  "wpWinPositions": [ {

  } ],
  "events": [ {
    "tStartMs": 8713,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "In the Egyptian Book of the Dead,\nthere’s a banishment spell that declares,"
    } ]
  }, {
    "tStartMs": 12884,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "“Be far from me, \nO vile cockroach.”"
    } ]
  }, {
    "tStartMs": 16095,
    "dDurationMs": 5547,
    "segs": [ {
      "utf8": "More than 3,000 years later, \nwe’re still trying to oust these insects."
    } ]
  }, {
    "tStartMs": 21642,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "But from poison traps \nto hastily brandished slippers,"
    } ]
  }, {
    "tStartMs": 25313,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "cockroaches seem to weather \njust about everything we throw at them."
    } ]
  }, {
    "tStartMs": 29734,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "So what makes cockroaches so hard to kill?"
    } ]
  }, {
    "tStartMs": 34405,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "There are nearly 5,000 cockroach species."
    } ]
  }, {
    "tStartMs": 37992,
    "dDurationMs": 5714,
    "segs": [ {
      "utf8": "99% of them live in a range of habitats\nwhere they play important ecological roles"
    } ]
  }, {
    "tStartMs": 43706,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "by recycling dead or decaying \norganic matter"
    } ]
  }, {
    "tStartMs": 47126,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "and nourishing other animals."
    } ]
  }, {
    "tStartMs": 49170,
    "dDurationMs": 5672,
    "segs": [ {
      "utf8": "But a couple dozen species adapted to live\nin close association with humans."
    } ]
  }, {
    "tStartMs": 55176,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "German and American cockroaches\nare among the most common."
    } ]
  }, {
    "tStartMs": 59097,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "And they owe their resilience\nto a combination"
    } ]
  }, {
    "tStartMs": 61724,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "of physical and chemical adaptations."
    } ]
  }, {
    "tStartMs": 65186,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "When it comes to old-fashioned \nremoval methods,"
    } ]
  }, {
    "tStartMs": 67897,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "they're troublingly tenacious."
    } ]
  }, {
    "tStartMs": 69941,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "An American cockroach’s sensory hairs \nor structures pick up subtle air currents"
    } ]
  }, {
    "tStartMs": 75238,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "and rapidly send signals \nto its central nervous system."
    } ]
  }, {
    "tStartMs": 79117,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "The roach can then turn and sprint\naway within a few milliseconds."
    } ]
  }, {
    "tStartMs": 83371,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "And it’s among the fastest invertebrates\never recorded,"
    } ]
  }, {
    "tStartMs": 86833,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "reaching speeds of up to 50\nbody lengths per second."
    } ]
  }, {
    "tStartMs": 90711,
    "dDurationMs": 4839,
    "segs": [ {
      "utf8": "This would be the human equivalent of\nrunning more than 300 kilometers per hour."
    } ]
  }, {
    "tStartMs": 96050,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "And finding a hiding place is no problem."
    } ]
  }, {
    "tStartMs": 98761,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "With its flattened, flexible body,"
    } ]
  }, {
    "tStartMs": 101097,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "an American cockroach can squeeze into \nspaces less than a quarter of its height."
    } ]
  }, {
    "tStartMs": 106185,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "Even if we do land a hit, \nit can withstand compressive forces"
    } ]
  }, {
    "tStartMs": 110273,
    "dDurationMs": 5589,
    "segs": [ {
      "utf8": "of up to 900 times its own weight \nby distributing the impact along its body."
    } ]
  }, {
    "tStartMs": 116654,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "And the cockroach’s toughness\ndoesn’t end there."
    } ]
  }, {
    "tStartMs": 119866,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Cockroaches can eat a variety \nof organic matter,"
    } ]
  }, {
    "tStartMs": 122785,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "including hair, dead skin, \nadhesives, and paper."
    } ]
  }, {
    "tStartMs": 127123,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "This is made possible by an expansive set \nof digestive enzymes."
    } ]
  }, {
    "tStartMs": 132253,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "Cockroaches are able to thrive \neven in nutrient-poor environments."
    } ]
  }, {
    "tStartMs": 137258,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Roaches often eat decaying foods\nthat are low in nitrogen—"
    } ]
  }, {
    "tStartMs": 141095,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "an essential component\nof DNA and proteins."
    } ]
  }, {
    "tStartMs": 144348,
    "dDurationMs": 4839,
    "segs": [ {
      "utf8": "But they survive by storing \nnitrogen-containing wastes in their bodies"
    } ]
  }, {
    "tStartMs": 149187,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and having a resident group\nof bacteria recycle the nitrogen"
    } ]
  }, {
    "tStartMs": 153191,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "into useful molecules for them."
    } ]
  }, {
    "tStartMs": 156194,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "Meanwhile, German cockroaches\nwill eat their own poop, vomit,"
    } ]
  }, {
    "tStartMs": 160323,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "and dead or dying colony members \nwithout hesitation."
    } ]
  }, {
    "tStartMs": 164410,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "An American cockroach will\nfrolic in sewers,"
    } ]
  }, {
    "tStartMs": 167205,
    "dDurationMs": 5338,
    "segs": [ {
      "utf8": "consuming excrement and toting microbes\nlike Staphylococcus aureus and E.coli."
    } ]
  }, {
    "tStartMs": 173377,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "But they’ll rarely suffer\nany consequences."
    } ]
  }, {
    "tStartMs": 176339,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "This is because they’re equipped \nwith genes that provide immunity"
    } ]
  }, {
    "tStartMs": 180051,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "against numerous pathogens."
    } ]
  }, {
    "tStartMs": 182011,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "These genes are often duplicated \nmany times over."
    } ]
  }, {
    "tStartMs": 185014,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "So when infected, the cockroach’s \nimmune system efficiently unleashes"
    } ]
  }, {
    "tStartMs": 189477,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "many antimicrobial molecules."
    } ]
  }, {
    "tStartMs": 192438,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "Cockroaches also have a slew of defenses\nagainst pesticides."
    } ]
  }, {
    "tStartMs": 196859,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "When a non-resistant roach walks \non a surface that’s been sprayed"
    } ]
  }, {
    "tStartMs": 200780,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "with a pyrethroid insecticide, \nfor example,"
    } ]
  }, {
    "tStartMs": 203574,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "the results will likely be fatal."
    } ]
  }, {
    "tStartMs": 205868,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "Once absorbed, the chemical binds\nto sodium channel proteins,"
    } ]
  }, {
    "tStartMs": 209789,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "which help propagate nerve impulses."
    } ]
  }, {
    "tStartMs": 212458,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The pyrethroid keeps \nthe sodium channels open,"
    } ]
  }, {
    "tStartMs": 215378,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "so the nerves fire repeatedly."
    } ]
  }, {
    "tStartMs": 217463,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "And soon, the cockroach dies."
    } ]
  }, {
    "tStartMs": 220049,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "But if a resistant roach is exposed \nto pyrethroids, it’ll be just fine."
    } ]
  }, {
    "tStartMs": 224845,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Genetic mutations have given\nthem sodium channels"
    } ]
  }, {
    "tStartMs": 227723,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "that the pyrethroids can’t bind to."
    } ]
  }, {
    "tStartMs": 230268,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The cockroach also produces more\ndetoxification enzymes,"
    } ]
  }, {
    "tStartMs": 234188,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "which render the pesticide harmless,"
    } ]
  }, {
    "tStartMs": 236274,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and the cockroach simply excretes \nit as a waste."
    } ]
  }, {
    "tStartMs": 239860,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "Because German cockroaches\nreproduce especially quickly,"
    } ]
  }, {
    "tStartMs": 243364,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "populations may evolve resistance \nto a new pesticide within months."
    } ]
  }, {
    "tStartMs": 248369,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "So far, they're already resistant\nto 43 different chemicals."
    } ]
  }, {
    "tStartMs": 253332,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "But contrary to popular belief,"
    } ]
  }, {
    "tStartMs": 255584,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "cockroaches would probably not survive \na nuclear apocalypse."
    } ]
  }, {
    "tStartMs": 259547,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Compared with other insects,"
    } ]
  }, {
    "tStartMs": 261215,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "cockroaches are only mildly\ntolerant to radiation."
    } ]
  }, {
    "tStartMs": 264635,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "They would die near the sites\nof nuclear explosions"
    } ]
  }, {
    "tStartMs": 267221,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "and would still be severely\ncompromised miles away."
    } ]
  }, {
    "tStartMs": 270641,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Moreover, disasters that threaten humanity"
    } ]
  }, {
    "tStartMs": 273644,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "also jeopardize the habitats and buffets \nwe provide roaches."
    } ]
  }, {
    "tStartMs": 278566,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Perhaps the only way to beat them \nis through our mutual destruction."
    } ]
  }, {
    "tStartMs": 282778,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "Or maybe cockroaches would find \neven more surprising ways to thrive"
    } ]
  }, {
    "tStartMs": 287491,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "long after we’re gone."
    } ]
  } ]
}
