  "wpWinPositions": [ {

  } ],
  "events": [ {
    "tStartMs": 1960,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "The first step to a comprehensive ant\nmanagement program is to inspect your"
    } ]
  }, {
    "tStartMs": 6920,
    "dDurationMs": 5690,
    "segs": [ {
      "utf8": "home inside and out for ants, potential\nentry ways and attractive nesting sites."
    } ]
  }, {
    "tStartMs": 12610,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Start by drawing a simple diagram of the\nfloor plan of your house and landscape."
    } ]
  }, {
    "tStartMs": 17470,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "Carry this with you as you inspect and\nmark places where you see ant activity"
    } ]
  }, {
    "tStartMs": 22160,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "or places where ants could enter."
    } ]
  }, {
    "tStartMs": 27570,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "Start your inspection inside and using a\nflashlight systematically inspect around"
    } ]
  }, {
    "tStartMs": 33430,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "the entire house, focusing on baseboards\nand walls where they meet the floor or"
    } ]
  }, {
    "tStartMs": 38140,
    "dDurationMs": 5849,
    "segs": [ {
      "utf8": "the ceiling. Ants often trail along these\nedges. Potted plants may also provide"
    } ]
  }, {
    "tStartMs": 43989,
    "dDurationMs": 6181,
    "segs": [ {
      "utf8": "harborage for ants. Inspect electrical\noutlets, vents, electrical fixtures and"
    } ]
  }, {
    "tStartMs": 50170,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "under furnishings. In kitchens, bathrooms\nand other rooms where you have plumbing,"
    } ]
  }, {
    "tStartMs": 55690,
    "dDurationMs": 5639,
    "segs": [ {
      "utf8": "open cabinets to inspect pipes and\ndrains. Ants often forage in these areas"
    } ]
  }, {
    "tStartMs": 61329,
    "dDurationMs": 7731,
    "segs": [ {
      "utf8": "for water. Look for possible attractive\nfood sources such as sweets or pet food."
    } ]
  }, {
    "tStartMs": 70729,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "Outside, inspect the walls of the\nstructure as low and as high as possible"
    } ]
  }, {
    "tStartMs": 75299,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "for ant trails. Pay special attention to\nlocations where ants were found inside"
    } ]
  }, {
    "tStartMs": 81299,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "for possible entry points that could be\nsealed up with caulk. Branches of trees"
    } ]
  }, {
    "tStartMs": 86759,
    "dDurationMs": 7051,
    "segs": [ {
      "utf8": "or shrubs, touching the house, may provide pathways for ants also inspect for ants"
    } ]
  }, {
    "tStartMs": 93810,
    "dDurationMs": 3479,
    "segs": [ {
      "utf8": "in trees and shrubs in the landscape\nthat might harbor aphids,"
    } ]
  }, {
    "tStartMs": 97289,
    "dDurationMs": 6571,
    "segs": [ {
      "utf8": "soft scales or other honeydew producing\ninsects. Check potted plants, leaf litter,"
    } ]
  }, {
    "tStartMs": 103860,
    "dDurationMs": 6989,
    "segs": [ {
      "utf8": "mulch, rocks or wood piles for ant nests\nespecially in moist areas. Look for"
    } ]
  }, {
    "tStartMs": 110849,
    "dDurationMs": 5431,
    "segs": [ {
      "utf8": "attractive food sources such as pet food.\nNote and fix leaky faucets or sprinklers"
    } ]
  }, {
    "tStartMs": 116280,
    "dDurationMs": 5490,
    "segs": [ {
      "utf8": "that provide water sources for ants.\nCarry out outdoor inspections in the"
    } ]
  }, {
    "tStartMs": 121770,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "morning or later afternoon.\nAnts tend to retreat to their nests when"
    } ]
  }, {
    "tStartMs": 125670,
    "dDurationMs": 4039,
    "segs": [ {
      "utf8": "it is hot and very sunny midday."
    } ]
  } ]
}
